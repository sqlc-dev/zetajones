# Hand-written expected parse trees for Cloud Spanner DDL that GoogleSQL's
# reference parser rejects, enabled by zetajones's SPANNER_DDL feature. These
# are not vendored and not generated: there is no reference output, so each
# tree was reviewed by hand. See "Spanner Extensions" in CLAUDE.md and the
# node shapes in ast/spanner.go.
#
# Spanner column definitions. Attributes before the DEFAULT or generated
# clause (NOT NULL) and after it (HIDDEN, PLACEMENT KEY, ...) form one
# ColumnAttributeList that follows the DEFAULT/generated child, as the
# reference's SpannerAlterColumnAction orders them.
[default language_features=MAXIMUM,+SPANNER_LEGACY_DDL,+TTL,+CREATE_LOCALITY_GROUP,+SPANNER_DDL]
CREATE TABLE t (a INT64 NOT NULL DEFAULT (1)) PRIMARY KEY (a)
--
CreateTableStatement [0-61] [CREATE TABLE...PRIMARY KEY (a)]
  PathExpression [13-14] [t]
    Identifier(t) [13-14] [t]
  TableElementList [15-45] [(a INT64 NOT NULL DEFAULT (1))]
    ColumnDefinition [16-44] [a INT64 NOT NULL DEFAULT (1)]
      Identifier(a) [16-17] [a]
      SimpleColumnSchema [18-44] [INT64 NOT NULL DEFAULT (1)]
        PathExpression [18-23] [INT64]
          Identifier(INT64) [18-23] [INT64]
        IntLiteral(1) [42-43] [1]
        ColumnAttributeList [24-32] [NOT NULL]
          NotNullColumnAttribute [24-32] [NOT NULL]
  SpannerTableOptions [46-61] [PRIMARY KEY (a)]
    PrimaryKey(ENFORCED) [46-61] [PRIMARY KEY (a)]
      PrimaryKeyElementList [58-61] [(a)]
        PrimaryKeyElement(ASC) [59-60] [a]
          Identifier(a) [59-60] [a]
==
CREATE TABLE t (a INT64 NOT NULL AS (b + 1) STORED, b INT64) PRIMARY KEY (a)
--
CreateTableStatement [0-76] [CREATE TABLE...PRIMARY KEY (a)]
  PathExpression [13-14] [t]
    Identifier(t) [13-14] [t]
  TableElementList [15-60] [(a INT64 NOT..., b INT64)]
    ColumnDefinition [16-50] [a INT64 NOT...1) STORED]
      Identifier(a) [16-17] [a]
      SimpleColumnSchema [18-50] [INT64 NOT...1) STORED]
        PathExpression [18-23] [INT64]
          Identifier(INT64) [18-23] [INT64]
        GeneratedColumnInfo(generated_mode=ALWAYS, stored_mode=STORED) [33-50] [AS (b + 1) STORED]
          BinaryExpression(+) [37-42] [b + 1]
            PathExpression [37-38] [b]
              Identifier(b) [37-38] [b]
            IntLiteral(1) [41-42] [1]
        ColumnAttributeList [24-32] [NOT NULL]
          NotNullColumnAttribute [24-32] [NOT NULL]
    ColumnDefinition [52-59] [b INT64]
      Identifier(b) [52-53] [b]
      SimpleColumnSchema [54-59] [INT64]
        PathExpression [54-59] [INT64]
          Identifier(INT64) [54-59] [INT64]
  SpannerTableOptions [61-76] [PRIMARY KEY (a)]
    PrimaryKey(ENFORCED) [61-76] [PRIMARY KEY (a)]
      PrimaryKeyElementList [73-76] [(a)]
        PrimaryKeyElement(ASC) [74-75] [a]
          Identifier(a) [74-75] [a]
