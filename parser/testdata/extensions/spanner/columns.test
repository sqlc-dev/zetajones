      ColumnDefinition [27-47] [a STRING(100) AS (b)]
        Identifier(a) [27-28] [a]
        SimpleColumnSchema [29-47] [STRING(100) AS (b)]
          PathExpression [29-35] [STRING]
            Identifier(STRING) [29-35] [STRING]
          TypeParameterList [35-39] [(100]
            IntLiteral(100) [36-39] [100]
          GeneratedColumnInfo(generated_mode=ALWAYS) [41-47] [AS (b)]
            PathExpression [45-46] [b]
              Identifier(b) [45-46] [b]
