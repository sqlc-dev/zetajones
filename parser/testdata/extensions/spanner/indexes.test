# Hand-written expected parse trees for Cloud Spanner DDL that GoogleSQL's
# reference parser rejects, enabled by zetajones's SPANNER_DDL feature. These
# are not vendored and not generated: there is no reference output, so each
# tree was reviewed by hand. See "Spanner Extensions" in CLAUDE.md and the
# node shapes in ast/spanner.go.
#
# Spanner search and vector index clauses, and ALTER INDEX stored columns.
# ORDER BY and WHERE reuse OrderBy and WhereClause; ", INTERLEAVE IN" reuses
# SpannerInterleaveClause, which follows OPTIONS in the tree as in the
# reference.
[default language_features=MAXIMUM,+SPANNER_LEGACY_DDL,+TTL,+CREATE_LOCALITY_GROUP,+SPANNER_DDL]
CREATE SEARCH INDEX i ON t(a_tokens) STORING (b) PARTITION BY c ORDER BY d DESC WHERE b IS NOT NULL OPTIONS (sort_order_sharding = true)
--
CreateIndexStatement(SEARCH) [0-136] [CREATE SEARCH...arding = true)]
  PathExpression [20-21] [i]
    Identifier(i) [20-21] [i]
  PathExpression [25-26] [t]
    Identifier(t) [25-26] [t]
  IndexItemList [26-36] [(a_tokens)]
    OrderingExpression(ASC) [27-35] [a_tokens]
      PathExpression [27-35] [a_tokens]
        Identifier(a_tokens) [27-35] [a_tokens]
  IndexStoringExpressionList [45-48] [(b)]
    PathExpression [46-47] [b]
      Identifier(b) [46-47] [b]
  PartitionBy [49-63] [PARTITION BY c]
    PathExpression [62-63] [c]
      Identifier(c) [62-63] [c]
  OrderBy [64-79] [ORDER BY d DESC]
    OrderingExpression(DESC) [73-79] [d DESC]
      PathExpression [73-74] [d]
        Identifier(d) [73-74] [d]
  WhereClause [80-99] [WHERE b IS NOT NULL]
    BinaryExpression(IS NOT) [86-99] [b IS NOT NULL]
      PathExpression [86-87] [b]
        Identifier(b) [86-87] [b]
      NullLiteral(NULL) [95-99] [NULL]
  OptionsList [108-136] [(sort_order_sharding = true)]
    OptionsEntry [109-135] [sort_order_sharding = true]
      Identifier(sort_order_sharding) [109-128] [sort_order_sharding]
      BooleanLiteral(true) [131-135] [true]
==
