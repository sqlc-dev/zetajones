# All of them, in order.
CREATE TABLE t (a INT64) PRIMARY KEY (a), INTERLEAVE IN PARENT p ON DELETE CASCADE, ROW DELETION POLICY (OLDER_THAN(a, INTERVAL 1 DAY)), OPTIONS (x = 1)
--
CreateTableStatement [0-152] [CREATE TABLE...OPTIONS (x = 1)]
  PathExpression [13-14] [t]
    Identifier(t) [13-14] [t]
  TableElementList [15-24] [(a INT64)]
    ColumnDefinition [16-23] [a INT64]
      Identifier(a) [16-17] [a]
      SimpleColumnSchema [18-23] [INT64]
        PathExpression [18-23] [INT64]
          Identifier(INT64) [18-23] [INT64]
  SpannerTableOptions [25-82] [PRIMARY KEY...DELETE CASCADE]
    PrimaryKey(ENFORCED) [25-40] [PRIMARY KEY (a)]
      PrimaryKeyElementList [37-40] [(a)]
        PrimaryKeyElement(ASC) [38-39] [a]
          Identifier(a) [38-39] [a]
    SpannerInterleaveClause [40-82] [, INTERLEAVE...DELETE CASCADE]
      PathExpression [63-64] [p]
        Identifier(p) [63-64] [p]
  TtlClause [84-135] [ROW DELETION...NTERVAL 1 DAY))]
    FunctionCall [105-134] [OLDER_THAN(a, INTERVAL 1 DAY)]
      PathExpression [105-115] [OLDER_THAN]
        Identifier(OLDER_THAN) [105-115] [OLDER_THAN]
      PathExpression [116-117] [a]
        Identifier(a) [116-117] [a]
      IntervalExpr [119-133] [INTERVAL 1 DAY]
        IntLiteral(1) [128-129] [1]
        Identifier(DAY) [130-133] [DAY]
  OptionsList [145-152] [(x = 1)]
    OptionsEntry [146-151] [x = 1]
      Identifier(x) [146-147] [x]
      IntLiteral(1) [150-151] [1]
