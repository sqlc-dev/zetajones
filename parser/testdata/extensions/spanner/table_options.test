# The reference form without a comma is unchanged.
CREATE TABLE t (a INT64) PRIMARY KEY (a) ROW DELETION POLICY (x) OPTIONS (y = 1)
--
CreateTableStatement [0-80] [CREATE TABLE...OPTIONS (y = 1)]
  PathExpression [13-14] [t]
    Identifier(t) [13-14] [t]
  TableElementList [15-24] [(a INT64)]
