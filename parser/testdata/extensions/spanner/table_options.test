# Without SPANNER_DDL the comma forms are rejected.
[language_features=MAXIMUM,+SPANNER_LEGACY_DDL,+TTL,+CREATE_LOCALITY_GROUP]
CREATE TABLE t (a INT64) PRIMARY KEY (a), OPTIONS (x = 1)
--
ERROR: Syntax error: Expected end of input but got "," [at 1:41]
CREATE TABLE t (a INT64) PRIMARY KEY (a), OPTIONS (x = 1)
                                        ^
