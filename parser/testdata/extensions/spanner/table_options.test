        TypeParameterList [41-45] [(MAX]
          MaxLiteral() [42-45] [MAX]
  SpannerTableOptions [48-105] [PRIMARY KEY...DELETE CASCADE]
    PrimaryKey(ENFORCED) [48-63] [PRIMARY KEY (a)]
