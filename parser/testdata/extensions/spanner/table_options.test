# Hand-written expected parse trees for Cloud Spanner DDL that GoogleSQL's
# reference parser rejects, enabled by zetajones's SPANNER_DDL feature. These
# are not vendored and not generated: there is no reference output, so each
# tree was reviewed by hand. See "Spanner Extensions" in CLAUDE.md and the
# node shapes in ast/spanner.go.
#
# Comma-separated clauses after a Spanner table's PRIMARY KEY. ROW DELETION
# POLICY and OPTIONS produce the same TtlClause and OptionsList the reference
# produces when they follow PRIMARY KEY without a comma; INTERLEAVE IN without
# PARENT is a SpannerInterleaveClause, as for indexes.
[default language_features=MAXIMUM,+SPANNER_LEGACY_DDL,+TTL,+CREATE_LOCALITY_GROUP,+SPANNER_DDL]
CREATE TABLE t (a INT64) PRIMARY KEY (a), ROW DELETION POLICY (OLDER_THAN(a, INTERVAL 1 DAY))
--
CreateTableStatement [0-93] [CREATE TABLE...NTERVAL 1 DAY))]
  PathExpression [13-14] [t]
    Identifier(t) [13-14] [t]
  TableElementList [15-24] [(a INT64)]
    ColumnDefinition [16-23] [a INT64]
      Identifier(a) [16-17] [a]
      SimpleColumnSchema [18-23] [INT64]
        PathExpression [18-23] [INT64]
          Identifier(INT64) [18-23] [INT64]
  SpannerTableOptions [25-40] [PRIMARY KEY (a)]
    PrimaryKey(ENFORCED) [25-40] [PRIMARY KEY (a)]
      PrimaryKeyElementList [37-40] [(a)]
        PrimaryKeyElement(ASC) [38-39] [a]
          Identifier(a) [38-39] [a]
  TtlClause [42-93] [ROW DELETION...NTERVAL 1 DAY))]
    FunctionCall [63-92] [OLDER_THAN(a, INTERVAL 1 DAY)]
      PathExpression [63-73] [OLDER_THAN]
        Identifier(OLDER_THAN) [63-73] [OLDER_THAN]
      PathExpression [74-75] [a]
        Identifier(a) [74-75] [a]
      IntervalExpr [77-91] [INTERVAL 1 DAY]
        IntLiteral(1) [86-87] [1]
        Identifier(DAY) [88-91] [DAY]
==
