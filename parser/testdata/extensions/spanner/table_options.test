        PathExpression [18-23] [INT64]
          Identifier(INT64) [18-23] [INT64]
    TableSynonym [25-36] [SYNONYM (u)]
      Identifier(u) [34-35] [u]
  SpannerTableOptions [38-53] [PRIMARY KEY (a)]
    PrimaryKey(ENFORCED) [38-53] [PRIMARY KEY (a)]
      PrimaryKeyElementList [50-53] [(a)]
        PrimaryKeyElement(ASC) [51-52] [a]
          Identifier(a) [51-52] [a]
