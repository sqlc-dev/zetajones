# Hand-written expected parse trees for Cloud Spanner DDL that GoogleSQL's
# reference parser rejects, enabled by zetajones's SPANNER_DDL feature. These
# are not vendored and not generated: there is no reference output, so each
# tree was reviewed by hand. See "Spanner Extensions" in CLAUDE.md and the
# node shapes in ast/spanner.go.
#
# Spanner identity columns: a bare IDENTITY, a sequence kind, SKIP RANGE and
# START COUNTER WITH (which reuses IdentityColumnStartWith), and ALTER
# IDENTITY.
[default language_features=MAXIMUM,+SPANNER_LEGACY_DDL,+TTL,+CREATE_LOCALITY_GROUP,+SPANNER_DDL]
CREATE TABLE t (a INT64 GENERATED BY DEFAULT AS IDENTITY) PRIMARY KEY (a)
--
CreateTableStatement [0-73] [CREATE TABLE...PRIMARY KEY (a)]
  PathExpression [13-14] [t]
    Identifier(t) [13-14] [t]
  TableElementList [15-57] [(a INT64 GENERATE...IDENTITY)]
    ColumnDefinition [16-56] [a INT64 GENERATED...S IDENTITY]
      Identifier(a) [16-17] [a]
      SimpleColumnSchema [18-56] [INT64 GENERATED...AS IDENTITY]
        PathExpression [18-23] [INT64]
          Identifier(INT64) [18-23] [INT64]
        GeneratedColumnInfo(generated_mode=BY_DEFAULT) [24-56] [GENERATED...AS IDENTITY]
          IdentityColumnInfo [48-56] [IDENTITY]
  SpannerTableOptions [58-73] [PRIMARY KEY (a)]
    PrimaryKey(ENFORCED) [58-73] [PRIMARY KEY (a)]
      PrimaryKeyElementList [70-73] [(a)]
        PrimaryKeyElement(ASC) [71-72] [a]
          Identifier(a) [71-72] [a]
==
