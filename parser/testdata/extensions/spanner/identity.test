          Identifier(INT64) [18-23] [INT64]
        GeneratedColumnInfo(generated_mode=BY_DEFAULT) [24-121] [GENERATED...RANGE 1, 10)]
          IdentityColumnInfo [48-121] [IDENTITY (...RANGE 1, 10)]
            Identifier(BIT_REVERSED_POSITIVE) [58-79] [BIT_REVERSED_POSITIVE]
            IdentityColumnStartWith [80-103] [START COUNTER WITH 1000]
              IntLiteral(1000) [99-103] [1000]
            IdentityColumnSkipRange [104-120] [SKIP RANGE 1, 10]
              IntLiteral(1) [115-116] [1]
              IntLiteral(10) [118-120] [10]
  SpannerTableOptions [123-138] [PRIMARY KEY (a)]
    PrimaryKey(ENFORCED) [123-138] [PRIMARY KEY (a)]
      PrimaryKeyElementList [135-138] [(a)]
        PrimaryKeyElement(ASC) [136-137] [a]
          Identifier(a) [136-137] [a]
