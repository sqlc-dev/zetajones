# https://docs.cloud.google.com/spanner/docs/reference/standard-sql/graph-query-statements#examples_2
GRAPH FinGraph
MATCH (p:Person)
CALL (p) {
  MATCH (p)-[:Owns]->(a:Account)-[t:Transfers]->()
  WHERE t.amount > 50
  RETURN a.Id AS account_id, t.amount
}
RETURN p.name, account_id, amount
ORDER BY p.name, amount DESC
