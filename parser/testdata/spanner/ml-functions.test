-- Join tables based on semantic understanding.
SELECT
  news.title, news.body, products.product_name
FROM
  news
JOIN products
  ON
    AI.IF(
      CONCAT(
        'Determine if the following news story is about product ',
        products.product_name,
        ': ',
        news.body))
WHERE
  category = 'tech'
