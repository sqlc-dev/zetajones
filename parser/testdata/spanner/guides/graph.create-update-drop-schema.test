CREATE OR REPLACE PROPERTY GRAPH sch2.FinGraph
  NODE TABLES (
    sch1.Person,
    sch2.Account
  )
  EDGE TABLES (
    sch1.PersonOwnAccount
      SOURCE KEY (id) REFERENCES Person (id)
      DESTINATION KEY (account_id) REFERENCES Account (id)
      LABEL Owns
  )
